\ProvidesPackage{lst-vhdl}
\RequirePackage{lst-common}
\RequirePackage{xcolor}


%% package options

\DeclareOption{inlinebar}{%
  \lstMakeShortInline[style=lst-common,language=VHDL]{|}
}

\def\c@background{\color{white}}
\DeclareOption{background}{%
  \def\c@background{\color{yellow!8!white}}
}

\lstnewenvironment{vhdl}
     {\lstset{style=lst-common,
              language=VHDL,
              backgroundcolor=\c@background}}
     {}

\newcommand{\inputvhdl}[1]{
  \lstinputlisting[style=lst-common,language=VHDL,backgroundcolor=c@background]{#1}
}

\ProcessOptions\relax
