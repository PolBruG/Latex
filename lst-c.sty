\ProvidesPackage{lst-c}
\RequirePackage{lst-common}
\RequirePackage{xcolor}


%% package options

\DeclareOption{inlinebar}{%
  \lstMakeShortInline[style=lst-common,language=c]{|}
}

\def\c@background{\color{white}}
\DeclareOption{background}{%
  \def\c@background{\color{yellow!8!white}}
}

\lstnewenvironment{langc}
     {\lstset{style=lst-common,
              language=c,
              backgroundcolor=\c@background}}
     {}

\newcommand{\inputc}[1]{
  \lstinputlisting[style=lst-common,language=c,backgroundcolor=c@background]{#1}
}

\ProcessOptions\relax
